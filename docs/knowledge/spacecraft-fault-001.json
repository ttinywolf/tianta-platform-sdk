  "rules": [
    {
      "rule_id": "R1",
      "if": "motor_current > nominal*1.5",
      "then": "degrade wheel to degraded"
    },
    {
      "rule_id": "R2",
      "if": "battery_soc > 0.99",
      "then": "trigger overcharge FDIR, reduce charge"
    },
    {
      "rule_id": "R3",
      "if": "temperature_derivative > threshold",
      "then": "raise thermal alarm"
    },
    {
      "rule_id": "R4",
      "if": "pointing_error > 3deg for 5s",
      "then": "initiate safe mode attitude hold"
    },
    {
      "rule_id": "R5",
      "if": "link_signal < -160dBm",
      "then": "switch redundant downlink"
    }
